[Unit]
Description=Install the Float default Flatpaks
Documentation=https://github.com/floatingskies/floatblue#flatpaks
# Intentionally NOT ordered after network-online.target: the desktop must come
# up even with no network at all. If the download fails the script exits
# non-zero and Restart=on-failure retries it in the background every 30s.
After=flatpak.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/float-flatpak-manager.sh
Restart=on-failure
RestartSec=30
StartLimitInterval=0
# Installing pulls hundreds of MB; do not let a slow mirror kill the unit.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
