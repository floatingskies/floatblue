# Default Flatpaks, one app-id per line. Lines starting with '#', and anything
# after a '#', are ignored. Installed automatically on first boot by
# /usr/libexec/float-flatpak-manager.sh.
#
# Nothing here duplicates an RPM the base image already ships. All of these are
# on Flathub proper — no third-party flatpakremote is added.

# Sandbox permission manager, so the default overrides are inspectable.
com.github.tchx84.Flatseal

# Plays essentially anything.
org.videolan.VLC

# Extension manager, for the one extension this image does ship (User Themes).
com.mattjakeman.ExtensionManager

# Password manager.
com.bitwarden.desktop

# Continuous file sync between machines, no account needed.
org.kde.kdeconnect

# Vector illustration.
org.inkscape.Inkscape
