# The base ublue images override GNOME's default fonts
# So we override them back: interface font is Intel One Mono,
# the document font stays as Adwaita Sans.

[org.gnome.desktop.wm.preferences]
titlebar-font='Intel One Mono 11'

[org.gnome.desktop.interface]
font-name='Intel One Mono 11'
document-font-name='Adwaita Sans 11'
monospace-font-name='Intel One Mono 14'