[Unit]
Description=Float: follow the GNOME light/dark preference across GTK, libadwaita, shell and icons
Documentation=man:gsettings(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/float-theme-sync
# gsettings monitor exits when the session goes away, and on a clean logout it
# exits successfully. Restarting on that is pointless work: the theme is already
# applied and apply is now a no-op when nothing differs, but re-running it every
# five seconds through a logout is churn for no gain. Restart only when the
# monitor actually failed, and not immediately.
Restart=on-failure
RestartSec=30
TimeoutStopSec=10

[Install]
WantedBy=default.target
