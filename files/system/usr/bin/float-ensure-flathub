#!/usr/bin/env bash
# Ensure the Flathub remote is configured, without installing anything.
#
# This image ships no Flatpak of its own: the app set is whatever Fedora 44's
# base image provides as RPMs, plus the RPMs this repo installs. Flatpak itself
# and the Flathub remote are still there and working — you just install apps
# yourself when you want them.
#
# Why this runs from a service instead of once at build time: a system-wide
# remote lives in /var/lib/flatpak/remotes.d, and `bootc switch` (rebase)
# resets /var. A remote added during the build would be gone after the first
# rebase. A boot-time check is idempotent and survives rebasing, and it also
# means we do not depend on how the base image happens to configure Flathub.
#
# Adding a remote only writes the .flatpakrepo file — no download, no network.
# So this cannot slow the boot down, and it is safe to run before NetworkManager
# is up.

set -euo pipefail

REMOTE=flathub
URL=https://dl.flathub.org/repo/flathub.flatpakrepo

if ! command -v flatpak >/dev/null 2>&1; then
    echo "float-ensure-flathub: flatpak not installed, nothing to do"
    exit 0
fi

if flatpak remotes --system --columns=name 2>/dev/null | grep -qx "$REMOTE"; then
    exit 0
fi

flatpak remote-add --if-not-exists --system "$REMOTE" "$URL"
echo "float-ensure-flathub: added the system-wide $REMOTE remote"
