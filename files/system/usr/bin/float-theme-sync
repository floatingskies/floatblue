#!/usr/bin/env bash
# float-theme-sync — keep the whole theme set following GNOME's light/dark
# preference.
#
# GNOME's Settings -> Appearance (and the quick-settings toggle) only flips
# `org.gnome.desktop.interface color-scheme`. By itself that is enough for
# Adwaita, because Adwaita ships a gtk.css and a gtk-dark.css per theme
# directory. Flat Remix does not work that way: its Light and Dark shades are
# *separate theme directories*, and its libadwaita/ directory only has a
# gtk.css (no gtk-dark.css), so a libadwaita app would look light either way.
#
# So this watches color-scheme and swaps all four layers together:
#
#   GTK      org.gnome.desktop.interface gtk-theme   + ~/.config/gtk-3.0/settings.ini
#                                                          + ~/.config/gtk-4.0/settings.ini
#   libadwaita  follows gtk-theme (picks up <theme>/libadwaita/gtk.css)
#   Shell    org.gnome.shell.extensions.user-theme name   (needs User Themes)
#   Icons    org.gnome.desktop.interface icon-theme
#
# Flatpak apps live in a sandbox with no access to the host theme dirs, so the
# system-wide flatpak override installed at build time covers the file access
# and GTK_THEME is re-pointed per user here.
#
# It runs as a per-user systemd service (enabled globally), so every login gets
# it, and applying on start means a fresh account is themed without anyone
# running a command.
#
# Consequence to be aware of: picking a theme by hand in Settings is fine until
# the next light/dark switch, which resets it back to the Blue pair. That is
# the intended behaviour — the toggle in Appearance is the single control.

set -uo pipefail

GTK_LIGHT=Flat-Remix-GTK-Blue-Light
GTK_DARK=Flat-Remix-GTK-Blue-Dark
ICONS_LIGHT=Flat-Remix-Blue-Light
ICONS_DARK=Flat-Remix-Blue-Dark
SHELL_LIGHT=Flat-Remix-Light
SHELL_DARK=Flat-Remix-Dark

SCHEMA=org.gnome.desktop.interface
SHELL_SCHEMA=org.gnome.shell.extensions.user-theme
SHELL_LIST_SCHEMA=org.gnome.shell
THEMES_DIR=/usr/share/themes
ICONS_DIR=/usr/share/icons

# A shell theme is inert without this extension. It is installed as a system
# extension by the theming recipe, but "installed" is not "enabled", and the
# base image's own enabled-extensions list is not ours to overwrite — so the
# UUID is appended to whatever is already enabled.
# Resolved from metadata.json at run time instead of written down here. It was
# wrong once, gcampari rather than gcampax, and since an unknown uuid in the
# extension list is not an error the shell simply never loaded anything and
# nothing said why.
find_user_theme_uuid() {
    local meta
    for meta in /usr/share/gnome-shell/extensions/*/metadata.json; do
        [[ -f $meta ]] || continue
        if grep -qE '"name"[[:space:]]*:[[:space:]]*"User Themes"' "$meta"; then
            sed -n 's/.*"uuid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$meta" | head -1
            return 0
        fi
    done
    return 1
}

USER_THEME_UUID=$(find_user_theme_uuid || true)

# Flatpak's own default inside a sandbox, plus the host's /usr/share. Without
# the last entry a libadwaita app finds only the runtime's Default and Emacs.
XDG_DATA_DIRS_FLATPAK=/app/share:/usr/share:/usr/share/runtime/share:/run/host/user-share:/run/host/share:/run/host/usr/share

log() { printf 'float-theme-sync: %s\n' "$*" >&2; }

# gsettings needs the session bus; without it (ssh, early boot, the Anaconda
# environment) there is nothing to theme and no reason to retry.
have_session() {
    gsettings get "$SCHEMA" color-scheme >/dev/null 2>&1
}

# Write a key into a GTK settings.ini.
#
# GTK reads these files with GKeyFile, and GKeyFile refuses to parse a file that
# does not start with a group: "Key file does not start with a group". So a bare
# "gtk-theme-name=..." is not merely ignored, it takes the whole file down with
# it, and every native GTK3/GTK4 app falls back to Adwaita while the icon theme
# (which goes through gsettings) still looks right.
#
# Three cases, because an account being rebased can be in any of them:
#   * no settings.ini at all          -> create it with [Settings]
#   * exists, has [Settings]          -> set or replace the key inside it
#   * exists, no [Settings] yet       -> put [Settings] on top, which both fixes
#                                        the parse and moves the stray keys into
#                                        the group GTK looks in
set_ini() {
    local file=$1 key=$2 value=$3
    mkdir -p "$(dirname "$file")"

    # Only create it. An unconditional touch updates the mtime of a file that
    # already exists, which is the one thing that makes GTK3 reload the theme,
    # so it has to be a create-if-absent and not a bare touch. That single line
    # was defeating the content comparison at the bottom of this function.
    [[ -e $file ]] || touch "$file"

    awk -v key="$key" -v value="$value" '
        BEGIN { insec = 0; written = 0 }
        /^[[:space:]]*\[/ {
            if ($0 ~ /^[[:space:]]*\[Settings\][[:space:]]*$/) {
                print
                if (!written) { print key "=" value; written = 1 }
                insec = 1
            } else {
                print
                insec = 0
            }
            next
        }
        {
            if (insec && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=")) {
                if (!written) { print key "=" value; written = 1 }
                next
            }
            # A non-empty line before any group header: this is the broken
            # "rebased account" case, so open the group on top of it.
            if (!insec && !written && $0 !~ /^[[:space:]]*(#|;|$)/) {
                print "[Settings]"
                print key "=" value
                written = 1
                insec = 1
                # Drop the stray line if it is the very key being set. It is
                # inside [Settings] now, so leaving it there gives the file two
                # values for one key and the old one wins on lookup, which looks
                # exactly like the theme being ignored.
                if ($0 ~ ("^[[:space:]]*" key "[[:space:]]*=")) next
            }
            print
        }
        END {
            if (!written) { print "[Settings]"; print key "=" value }
        }
    ' "$file" >"$file.tmp" || return 1

    # Compare before replacing. GTK3 watches settings.ini and reloads the theme
    # when the file changes, so replacing it with identical content is not free:
    # it changes the mtime, GTK3 notices, and every open GTK3 app re-parses the
    # theme it already had. Leaving the file alone when nothing changed is what
    # makes a second login cost nothing.
    if [[ -f $file ]] && cmp -s "$file.tmp" "$file"; then
        rm -f "$file.tmp"
        return 0
    fi
    mv "$file.tmp" "$file"
}

# Writing a GTK key is not free. gsettings set gtk-theme, icon-theme or the shell
# theme name makes every process already running re-read the theme: GTK4 reloads
# the whole stylesheet, GTK3 reloads settings.ini, the shell rebuilds the panel.
# Setting a key to the value it already holds still writes to dconf and still
# triggers all of it.
#
# At login that is the difference between a session that opens themed and one that
# opens unthemed and then re-themes itself in front of the user, with every app
# parsing its CSS twice. So every write goes through here and is skipped when the
# value already matches.
set_gsettings_if_changed() {
    local schema=$1 key=$2 value=$3 current
    current=$(gsettings get "$schema" "$key" 2>/dev/null || true)
    current=${current#\'}
    current=${current%\'}
    [[ $current == "$value" ]] && return 0
    gsettings set "$schema" "$key" "$value"
}

# Put the User Themes extension in the enabled list without discarding
# whatever the base image already enables. Adding to the array (rather than
# setting a gschema override for enabled-extensions) is deliberate: an
# override would replace Bluefin's own extension list wholesale.
ensure_user_theme_enabled() {
[[ -n $USER_THEME_UUID ]] || {
    log "no User Themes extension found, cannot enable it"
    return 0
}

    local current
    current=$(gsettings get "$SHELL_LIST_SCHEMA" enabled-extensions 2>/dev/null || echo "@as []")
    [[ $current == *"$USER_THEME_UUID"* ]] && return 0

    # "gsettings get" prints an empty array as @as []; anything else is a
    # non-empty list we can append to. Note the comma: dropping the closing
    # bracket and gluing the new entry straight onto the previous one yields
    # an invalid GVariant and the whole set is silently rejected.
    if [[ $current == "@as []" || $current == "'@as []'" ]]; then
        new="['$USER_THEME_UUID']"
    else
        new="${current%]},'$USER_THEME_UUID']"
    fi

    if gsettings set "$SHELL_LIST_SCHEMA" enabled-extensions "$new"; then
        log "enabled $USER_THEME_UUID"
    else
        log "could not add $USER_THEME_UUID to enabled-extensions"
    fi
}

# GTK4 loads $XDG_CONFIG_HOME/gtk-4.0/gtk.css as a user stylesheet, on top of
# whatever the theme provides. The theme's own gtk-4.0/gtk.css is a 5000 line
# standalone sheet and it does not sit well with a modern libadwaita, which is
# the whole reason libadwaita exists as a separate directory. So the libadwaita
# half goes here instead: an 83 line overlay carrying the Flat Remix palette
# and the titlebutton rules, layered over the theme, which is the shape
# libadwaita was designed for.
#
# It lands in the shared config dir, so flatpaks pick it up as well without
# needing an override of their own. Re-copying on every switch is what keeps
# light and dark in step, since each variant ships its own copy of the overlay
# and the two are not interchangeable.
install_user_stylesheet() {
    local theme=$1 src=$THEMES_DIR/$1/libadwaita dst=$2 unchanged=0

    if [[ ! -s $src/gtk.css ]]; then
        log "no libadwaita/gtk.css in $theme, leaving the user stylesheet alone"
        return 0
    fi

    mkdir -p "$dst"

    # Same reasoning as set_ini: GTK4 watches this exact file and re-parses it
    # when it changes. Rewriting it with the same bytes on every login makes
    # every open libadwaita app reload the overlay for nothing.
    if [[ -f $dst/gtk.css ]] && cmp -s "$src/gtk.css" "$dst/gtk.css"; then
        unchanged=1
    else
        cp -a "$src/gtk.css" "$dst/gtk.css"
        unchanged=0
    fi

    # The overlay points at assets/ by relative path, so the directory has to
    # travel with it or the window controls render bare.
    #
    # Only touched when the overlay itself changed. The previous version did
    # "rm -rf assets" unconditionally on every login, which for one instant left
    # the overlay pointing at a directory that was not there, and then copied the
    # whole tree back. The overlay and the assets ship together, so if the overlay
    # is already current the assets are too.
    if [[ -d $src/assets && $unchanged -eq 0 ]]; then
        rm -rf "${dst:?}/assets"
        cp -a "$src/assets" "$dst/assets"
    fi
}

apply() {
    local scheme gtk icons shell cfg

    scheme=$(gsettings get "$SCHEMA" color-scheme 2>/dev/null | tr -d "'")
    if [[ $scheme == prefer-dark ]]; then
        gtk=$GTK_DARK icons=$ICONS_DARK shell=$SHELL_DARK
    else
        gtk=$GTK_LIGHT icons=$ICONS_LIGHT shell=$SHELL_LIGHT
    fi

    cfg=${XDG_CONFIG_HOME:-$HOME/.config}

    # Each layer is checked on its own, so a partial install degrades one layer
    # instead of silently pointing every layer at a theme that is not there.
    if [[ -d $THEMES_DIR/$gtk ]]; then
        set_gsettings_if_changed "$SCHEMA" gtk-theme "$gtk"
        set_ini "$cfg/gtk-3.0/settings.ini" gtk-theme-name "$gtk"
        set_ini "$cfg/gtk-4.0/settings.ini" gtk-theme-name "$gtk"
        install_user_stylesheet "$gtk" "$cfg/gtk-4.0"
    else
        log "GTK theme missing at $THEMES_DIR/$gtk, leaving GTK alone"
        gtk=""
    fi

    if [[ -d $ICONS_DIR/$icons ]]; then
        set_gsettings_if_changed "$SCHEMA" icon-theme "$icons"
    else
        log "icon theme missing at $ICONS_DIR/$icons, leaving icons alone"
        icons=""
    fi

    # Enable the extension first and unconditionally. The schema is how the theme
    # name is stored, but the extension is what makes gnome-shell read it, and
    # gating the enable on the schema being compiled means neither ever happens
    # when the schema is the thing that is missing.
    ensure_user_theme_enabled

    if [[ ! -d $THEMES_DIR/$shell ]]; then
        log "shell theme missing at $THEMES_DIR/$shell, leaving the shell alone"
    elif gsettings list-schemas 2>/dev/null | grep -qx "$SHELL_SCHEMA"; then
        set_gsettings_if_changed "$SHELL_SCHEMA" name "$shell"
    else
        log "user-theme schema not available yet, shell theme will apply next login"
    fi

    # The system-wide override, installed once at build time by
    # apply-flatpak-theme-access.sh, already covers almost all of this: the
    # xdg-config/gtk-3.0 and xdg-config/gtk-4.0 mounts, and XDG_DATA_DIRS with
    # the host's /usr/share on it. Those are what GTK4 and libadwaita need,
    # since they read gtk-theme-name from dconf rather than from GTK_THEME.
    #
    # So the only thing left for a per-user override is GTK_THEME, which is
    # GTK3-only. Writing it costs a flatpak process and a config write, so it is
    # skipped when the override already says what it should, which is the normal
    # case on every login after the first.
    #
    # /usr/share/themes is deliberately not mounted. Flatpak reserves /usr, that
    # mount is refused at every launch, and the theme never arrives.
    if [[ -n $gtk ]] && command -v flatpak >/dev/null 2>&1; then
        if [[ $(flatpak override --user --show 2>/dev/null || true) != *"GTK_THEME=$gtk"* ]]; then
            flatpak override --user \
                --filesystem=xdg-config/gtk-3.0:ro \
                --filesystem=xdg-config/gtk-4.0:ro \
                --env=GTK_THEME="$gtk" \
                --env=XDG_DATA_DIRS="$XDG_DATA_DIRS_FLATPAK" >/dev/null 2>&1 || true
        fi
    fi

    log "applied gtk=${gtk:-none} icons=${icons:-none} shell=$shell"
}

if ! have_session; then
    exit 0
fi

apply

# Block on the stream and re-apply on every change. gsettings monitor exits
# non-zero if the schema goes away, in which case systemd restarts us.
gsettings monitor "$SCHEMA" color-scheme | while read -r _; do
    apply
done
