[org/gnome/shell]
# Blur My Shell is off. It is a large patch to the shell compositor that costs
# frame time on the hardware this image targets and that nothing here asks for.
disabled-extensions=['blur-my-shell@aunetx']

[org/gnome/shell/extensions/user-theme]
# Left unset on purpose. This key only means anything while the User Themes
# extension is installed and enabled, and with stock Adwaita there is no shell
# theme to select, so the shell uses its own default. Writing a name here would
# mean shipping a theme directory to go with it.
name=''

# The GTK and icon themes used to be pinned here as system defaults, so the session
# would start themed instead of opening plain and correcting itself. That was worth
# doing when a per-session service had to apply them. There is no service now and
# Adwaita is what GNOME starts with, so the pinning lives in
# zz500-float-theme.gschema.override where the rest of the theme settings are.
